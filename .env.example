# Brevo SMTP (Render backend service environment)
# Prefer the HTTPS API on a Render free web service; it uses outbound port 443.
# Create an API key in Brevo and set it in Render (not the SMTP key).
BREVO_API_KEY=your-brevo-api-key

# SMTP fallback for hosts/plans that permit outbound SMTP ports.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_SENDER_EMAIL=tugnaclode5@gmail.com
BREVO_SENDER_NAME=3K Kitchen

# Public deployed frontend URL used in password reset links (no trailing slash)
FRONTEND_URL=https://3kitchen.vercel.app
